   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "# 4) RANA finishing tool (branding, subtitles, end card, 1080x1920 export)\nRANA_FILM_RAW = 'https://raw.githubusercontent.com/sricharanmunagala39-del/Rana.AI/work-film/film'\n!mkdir -p /kaggle/working/rana && cd /kaggle/working/rana && wget -q -O finish.py {RANA_FILM_RAW}/finish.py && wget -q -O BRIEF_TEMPLATE.md {RANA_FILM_RAW}/BRIEF_TEMPLATE.md && ls -la"
