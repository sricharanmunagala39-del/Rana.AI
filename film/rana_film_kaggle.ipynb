   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "# 3) Install (T4 = Turing: Triton 3.2 + SageAttention 1)  ~10 min\n!pip -q install {TORCH}\n!cd /tmp/Wan2GP && pip -q install -r requirements.txt\n!pip -q install \"triton==3.2.0\" \"sageattention==1.0.6\" || echo 'sage optional - falling back to sdpa'\n!apt-get -qq install -y fonts-noto-core fonts-noto-ui-core >/dev/null 2>&1; fc-list | grep -ci telugu"
  },
